// Rendering/navigation fixtures only. No real user sessions or database writes.
import assert from "node:assert/strict";
import test, { after } from "node:test";
import path from "node:path";
import { fileURLToPath } from "node:url";
import React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { createServer } from "vite";
const root = fileURLToPath(new URL("..", import.meta.url));
const key = "__gradexaAdminRender";
const mocks = {
  [path.join(root, "features/deletions/actions")]: `export async function previewDeletionAction(){throw Error("No request during render");} export async function deleteRecordAction(){throw Error("No deletion during render");}`,
  [path.join(root, "features/workspace/store")]: `export function useWorkspace(){return globalThis.${key}.workspace;} export async function refreshWorkspace(){} export async function saveWorkspace(){throw Error('No writes in render tests');}`,
  [path.join(root, "features/courses/use-courses")]: `export async function refreshCourses(){} export function useCourses(){return {courses:[],ready:true,error:null};}`,
  [path.join(root, "features/enrollments/use-enrollments")]: `export async function refreshEnrollments(){}`,
  [path.join(root, "features/lessons/use-lessons")]: `export async function refreshLessons(){} export async function saveLesson(){throw Error('No writes in render tests');}`,
  [path.join(root, "features/lessons/lesson-migration")]: `export function LessonMigration(){return null;}`,
  [path.join(root, "features/workspace/workspace-migration")]: `export function WorkspaceMigration(){return null;}`,
  [path.join(root, "features/invitations/actions")]: `export async function sendInvitationAction(){throw Error('No invitations in render tests');}`,
  [path.join(root, "components/auth/logout-button")]: `export function LogoutButton(){return null;}`,
  [path.join(root, "components/ui/dialog")]: `import React from 'react'; const Box=({children})=>React.createElement('div',null,children); export const Dialog=Box,DialogContent=Box,DialogHeader=Box,DialogTitle=Box,DialogDescription=Box;`,
  [path.join(root, "components/ui/command")]: `import React from 'react'; const Box=({children,heading})=>React.createElement('div',null,heading,children); export const Command=Box,CommandEmpty=Box,CommandGroup=Box,CommandList=Box; export const CommandInput=()=>null; export function CommandItem({children,value,onSelect}){globalThis.${key}.commands.push({value,onSelect});return React.createElement('div',null,children);}`,
  "next/link": `import React from 'react'; export default function Link({href,prefetch,scroll,replace,...props}){return React.createElement('a',{...props,href});}`,
  "next/navigation": `export function usePathname(){return globalThis.${key}.pathname;} export function useRouter(){return {push(href){globalThis.${key}.navigations.push(href)},refresh(){globalThis.${key}.refreshes++}};}`,
};
const vite = await createServer({ appType: "custom", configFile: false, root, resolve: { alias: { "@": root, "next/navigation": "\0admin-fixture:next/navigation", "next/link": "\0admin-fixture:next/link" } }, esbuild: { jsx: "automatic" }, server: { middlewareMode: true, ws: false }, plugins: [{
  name: "admin-render-fixtures", enforce: "pre",
  transform(code, id) {
    if (!id.startsWith(root) || !/\.[jt]sx?$/.test(id)) return;
    // Vite can externalize bare Next imports before resolveId in SSR.
    return code.replaceAll('from "next/navigation"', 'from "virtual:admin-navigation"').replaceAll('from "next/link"', 'from "virtual:admin-link"');
  },
  resolveId(source, importer) {
    if (source === "virtual:admin-navigation") return "\0admin-fixture:next/navigation";
    if (source === "virtual:admin-link") return "\0admin-fixture:next/link";
    const resolved = source.startsWith(".") && importer ? path.resolve(path.dirname(importer), source) : source;
    const candidate = Object.hasOwn(mocks, resolved) ? resolved : path.normalize(resolved).replace(/\.[jt]sx?$/, "");
    if (Object.hasOwn(mocks, candidate)) return "\0admin-fixture:" + candidate;
  },
  load(id) { if (id.startsWith("\0admin-fixture:")) return mocks[id.slice("\0admin-fixture:".length)]; },
}] });
after(async () => { delete globalThis[key]; await vite.close(); });
const { seedWorkspace } = await vite.ssrLoadModule("/features/workspace/model.ts");
const { seedCourses } = await vite.ssrLoadModule("/features/courses/model.ts");
const { AdminLessons } = await vite.ssrLoadModule("/features/workspace/admin-lessons.tsx");
const { QuizEditor } = await vite.ssrLoadModule("/features/workspace/admin-quizzes.tsx");
const { AdminStudents } = await vite.ssrLoadModule("/features/workspace/admin-students.tsx");
const { CommandPalette } = await vite.ssrLoadModule("/features/dashboard/command-palette.tsx");
const { StudentShell } = await vite.ssrLoadModule("/components/layout/student-shell.tsx");
const { LocalNotice } = await vite.ssrLoadModule("/features/courses/course-shared.tsx");
const { Choice } = await vite.ssrLoadModule("/features/workspace/ui.tsx");
const { RouteError } = await vite.ssrLoadModule("/components/layout/route-error.tsx");
const { RouteLoading } = await vite.ssrLoadModule("/components/layout/route-loading.tsx");
function fixture() {
  const data = structuredClone(seedWorkspace), courses = structuredClone(seedCourses);
  const student = { ...data.students[0], status: "active", name: "Yangi Ism", courseIds: [courses[0].id] };
  data.students = [student]; data.tasks = []; data.attempts = [];
  globalThis[key] = { workspace: { data, courses, student, ready: true, error: null }, commands: [], navigations: [], refreshes: 0, pathname: "/admin" };
  return globalThis[key];
}
const render = (component, props = {}) => renderToStaticMarkup(React.createElement(component, props));
test("admin lesson list paginates without losing the total and supports empty state", () => {
  const { workspace: w } = fixture();
  w.data.lessons = Array.from({ length: 24 }, (_, i) => ({ ...seedWorkspace.lessons[0], id: "lesson-" + i, order: i + 1, title: "Unique lesson " + i }));
  const html = render(AdminLessons);
  assert.equal((html.match(/aria-label="Unique lesson \d+ tahrirlash"/g) ?? []).length, 10);
  assert.equal((html.match(/aria-label="Unique lesson \d+ — o‘chirish"/g) ?? []).length, 10);
  assert.ok(html.includes("1–10 / 24 dars")); assert.ok(html.includes("Darslar sahifalari"));
  w.data.lessons = []; assert.ok(render(AdminLessons).includes("Dars topilmadi"));
});
test("admin palette uses real labels and navigates lessons/quizzes/invitations", () => {
  const f = fixture(); let closed = false;
  const html = render(CommandPalette, { open: true, onOpenChange: value => { closed = !value; } });
  assert.ok(!html.includes("Talabalar · namuna")); assert.ok(!html.includes("Student kabineti"));
  const lesson = f.workspace.data.lessons[0], quiz = f.workspace.data.quizzes[0];
  for (const [needle, destination] of [["dars " + lesson.title, "/admin/lessons/" + lesson.id], ["test quiz " + quiz.title, "/admin/quizzes/" + quiz.id], ["Kutilayotgan takliflar", "/admin/students?status=invited"]]) {
    f.commands.find(command => command.value.startsWith(needle)).onSelect();
    assert.equal(f.navigations.at(-1), destination);
  }
  assert.equal(closed, true);
});
test("invitation URL filter opens only invited students", () => {
  const f = fixture(); f.workspace.data.students.push({ ...f.workspace.student, id: "invite", name: "Taklifdagi Talaba", email: "invite@example.test", status: "invited", invitation: true, invitationState: "draft" });
  const html = render(AdminStudents, { initialStatus: "invited" });
  assert.ok(html.includes("Taklifdagi Talaba")); assert.ok(!html.includes('href="/admin/students/' + f.workspace.student.id + '"'));
  assert.ok(html.includes('aria-label="Taklifdagi Talaba — o‘chirish"'));
});
test("student shell uses current profile and locked search opens course, not denied lesson", () => {
  const f = fixture(); const course = f.workspace.courses[0]; course.status = "published"; course.sequential = true;
  f.workspace.data.completed = {};
  f.workspace.data.lessons = [1, 2].map(order => ({ ...seedWorkspace.lessons[0], courseId: course.id, id: "lesson-" + order, title: "Lesson " + order, order, published: true }));
  f.pathname = "/student/lessons/lesson-1";
  const html = render(StudentShell, { profile: { id: f.workspace.student.id, full_name: "Old Name", initials: "ZZ", role: "student", status: "active", email: "student@example.test" }, children: "Dars matni" });
  assert.ok(html.includes("Yangi Ism")); assert.ok(!html.includes(">ZZ<")); assert.ok(html.includes("Darslar"));
  assert.ok(!html.includes("Butunlay o‘chirish"));
  f.commands.find(command => command.value.startsWith("Lesson 2")).onSelect();
  assert.equal(f.navigations.at(-1), "/student/courses/" + course.id);
  f.commands.find(command => command.value.startsWith("Lesson 1")).onSelect();
  assert.equal(f.navigations.at(-1), "/student/lessons/lesson-1");
});
test("quiz editor keeps an accessible form fieldset and existing answer controls", () => {
  fixture(); const html = render(QuizEditor);
  assert.ok(html.includes("<fieldset")); assert.ok(html.includes('aria-busy="false"')); assert.ok(html.includes("To‘g‘ri javob"));
  assert.ok(html.includes("Testni saqlash"));
});
test("Choice disables the Radix select when a save is pending", () => {
  const html = render(Choice, { label: "Holat", value: "active", onChange() {}, items: [{ value: "active", label: "Faol" }], disabled: true });
  assert.match(html, /role="combobox"[^>]*disabled=""/);
});
test("recovery UI does not disclose raw errors and retains role-specific navigation", () => {
  fixture(); const error = Object.assign(new Error("PRIVATE_TOKEN=secret"), { digest: "123456" });
  const html = render(RouteError, { error, reset() {}, home: "/admin" });
  assert.ok(!html.includes("PRIVATE_TOKEN")); assert.ok(html.includes("123456")); assert.ok(html.includes('href="/admin"')); assert.ok(html.includes("Qayta urinish"));
  error.digest = "https://secret.example/token";
  assert.ok(!render(RouteError, { error, reset() {} }).includes("secret.example"));
});
test("loading is accessible and storage copy matches the Supabase data layer", () => {
  const loading = render(RouteLoading); assert.ok(loading.includes('role="status"')); assert.ok(loading.includes('aria-busy="true"'));
  const notice = render(LocalNotice); assert.ok(notice.includes("Supabase")); assert.ok(!notice.includes("brauzerdagi"));
});
