"use client";

import { useId, type ReactNode } from "react";
import Link from "next/link";
import { ArrowUp, BookOpen, type LucideIcon } from "lucide-react";
import { Area, AreaChart, CartesianGrid, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "@/components/ui/table";
import { Progress } from "@/components/ui/progress";
import { percent, weekdays, type CourseRow, type FunnelStep, type TrendPoint } from "./report-model";

export function ReportSelect({ label, value, onChange, items }: {
  label: string; value: string; onChange: (value: string) => void; items: { value: string; label: string }[];
}) {
  return <Select value={value} onValueChange={onChange}>
    <SelectTrigger size="sm" aria-label={label} className="gx-select"><SelectValue>{items.find(x => x.value === value)?.label}</SelectValue></SelectTrigger>
    <SelectContent>{items.map(x => <SelectItem key={x.value} value={x.value}>{x.label}</SelectItem>)}</SelectContent>
  </Select>;
}
export function Panel({ title, controls, children, className = "", id }: {
  title: string; controls?: ReactNode; children: ReactNode; className?: string; id?: string;
}) {
  const heading = useId();
  return <section id={id} tabIndex={id ? -1 : undefined} aria-labelledby={heading} className={`gx-panel ${className}`}>
    <div className="gx-panel-heading"><h2 id={heading}>{title}</h2>{controls && <div className="gx-controls">{controls}</div>}</div>
    {children}
  </section>;
}
export function Metrics({ items, compact = false }: { compact?: boolean; items: { label: string; value: string; icon: LucideIcon; change?: string; note?: string }[] }) {
  return <section className={`gx-metrics ${compact ? "gx-metrics-compact" : ""}`} aria-label="Asosiy ko‘rsatkichlar">
    {items.map(({ icon: Icon, ...m }) => <article key={m.label} className="gx-stat">
      <span className="gx-stat-icon"><Icon size={24} strokeWidth={1.7} aria-hidden="true" /></span>
      <div className="gx-stat-content"><strong>{m.value}</strong><span>{m.label}</span></div>
      {(m.change || m.note) && <p className="gx-stat-change">{m.change && <b><ArrowUp size={14} />{m.change}</b>}<span>{m.note}</span></p>}
    </article>)}
  </section>;
}
const tip = { background: "#05271e", border: "1px solid #23715a", borderRadius: 8, color: "#f1faf6", fontSize: 13 };
const tick = { fill: "#a7c4ba", fontSize: 12 };
export function WeeklyChart({ data }: { data: { day: string; active: number }[] }) {
  const id = useId().replaceAll(":", "");
  return <div className="gx-chart" aria-label={data.map(d => `${d.day}: ${d.active} faol talaba`).join("; ")}>
    <ResponsiveContainer width="100%" height="100%" minWidth={0} initialDimension={{ width: 600, height: 224 }}>
      <AreaChart data={data} margin={{ top: 14, right: 10, bottom: 0, left: -22 }} accessibilityLayer>
        <defs><linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#00e5ab" stopOpacity={0.42} /><stop offset="100%" stopColor="#00e5ab" stopOpacity={0.015} /></linearGradient></defs>
        <CartesianGrid stroke="#184338" strokeDasharray="0" />
        <XAxis dataKey="day" tick={tick} axisLine={false} tickLine={false} tickMargin={10} />
        <YAxis allowDecimals={false} tick={tick} axisLine={false} tickLine={false} />
        <Tooltip contentStyle={tip} cursor={{ stroke: "#629484", strokeDasharray: "4 4" }} />
        <Area type="monotone" dataKey="active" name="Faol talabalar" stroke="#00e5ab" strokeWidth={2} fill={`url(#${id})`} dot={{ r: 3, fill: "#003e30", strokeWidth: 1.5 }} activeDot={{ r: 5, fill: "#f7c957", stroke: "#fff4c3", strokeWidth: 2 }} isAnimationActive={false} />
      </AreaChart>
    </ResponsiveContainer>
  </div>;
}
export function TrendChart({ data, activityLabel }: { data: TrendPoint[]; activityLabel: string }) {
  return <><div className="gx-chart gx-trend-chart" aria-label="Tanlangan davrdagi talabalar va faollik grafigi">
    <ResponsiveContainer width="100%" height="100%" minWidth={0} initialDimension={{ width: 600, height: 208 }}>
      <LineChart data={data} margin={{ top: 10, right: 12, bottom: 0, left: -22 }} accessibilityLayer>
        <CartesianGrid stroke="#184338" />
        <XAxis dataKey="date" tickFormatter={d => `${Number(String(d).slice(8))}`} tick={tick} axisLine={false} tickLine={false} minTickGap={24} tickMargin={10} />
        <YAxis tick={tick} axisLine={false} tickLine={false} allowDecimals={false} />
        <Tooltip contentStyle={tip} labelFormatter={d => String(d)} />
        <Line type="monotone" dataKey="active" name="Faol talabalar" stroke="#00e5ab" strokeWidth={2} dot={{ r: 2.5, fill: "#023429", strokeWidth: 1.5 }} activeDot={{ r: 5 }} isAnimationActive={false} />
        <Line type="monotone" dataKey="activity" name={activityLabel} stroke="#f6c854" strokeWidth={2} dot={{ r: 2.5, fill: "#36331a", strokeWidth: 1.5 }} activeDot={{ r: 5 }} isAnimationActive={false} />
      </LineChart>
    </ResponsiveContainer>
  </div><div className="gx-chart-legend"><span><i />Faol talabalar</span><span><i className="gx-gold" />{activityLabel}</span></div></>;
}
const art: Record<string, string> = { frontend: "course-frontend", javascript: "course-javascript", ui: "course-ui" };
export function CourseTable({ courses }: { courses: CourseRow[] }) {
  return <Table className="gx-course-table"><TableHeader><TableRow><TableHead>Kurs</TableHead><TableHead>Talabalar</TableHead><TableHead>Yakunlash darajasi</TableHead></TableRow></TableHeader>
    <TableBody>{courses.map(c => <TableRow key={c.id}>
      <TableCell><Link href={`/admin/courses/${c.id}`} className="gx-course-name">
        <span className="gx-course-art">{art[c.id] ? <img src={`/images/gradexa/${art[c.id]}.png`} width={44} height={36} alt="" loading="lazy" /> : <BookOpen size={22} />}</span><span>{c.name}</span>
      </Link></TableCell><TableCell>{c.students}</TableCell>
      <TableCell><div className="gx-course-progress"><Progress value={c.progress} aria-label={`${c.name} yakunlanishi`} /><span>{c.progress}%</span></div></TableCell>
    </TableRow>)}{!courses.length && <TableRow><TableCell colSpan={3} className="gx-empty">Bu yerda hali kurslar yo‘q.</TableCell></TableRow>}</TableBody>
  </Table>;
}
export function CompletionDonut({ complete = 0, progress = 0 }: { complete?: number; progress?: number }) {
  const remainder = Math.max(0, Math.round((100 - complete - progress) * 10) / 10);
  return <div className="gx-completion"><div className="gx-donut" role="img" aria-label={`Yakunlangan ${complete}%, jarayonda ${progress}%, boshlanmagan ${remainder}%`} style={{ background: `conic-gradient(from -90deg, #00e5ab 0% ${complete}%, #f6c854 ${complete}% ${complete + progress}%, #64897f ${complete + progress}% 100%)` }}>
    <div><strong>{complete}%</strong><span>Yakunlandi</span></div>
  </div><ul className="gx-donut-legend">{[["Yakunlangan", complete, ""], ["Jarayonda", progress, "gx-gold"], ["Boshlanmagan", remainder, "gx-muted"]].map(([label, value, color]) => <li key={String(label)}><i className={String(color)} /><span>{label}<strong>{value}%</strong></span></li>)}</ul></div>;
}
export function Funnel({ steps }: { steps: FunnelStep[] }) {
  const total = steps[0]?.value || 0;
  return <div className="gx-funnel"><div className="gx-funnel-art" aria-hidden="true">
    {steps.map((step, i) => <div key={step.label} className={`gx-funnel-shape gx-funnel-shape-${i}`} style={{ width: `${100 - i * 19}%` }} />)}
  </div><ol>{steps.map(step => <li key={step.label}><span>{step.label}</span><div><strong>{step.value}</strong><small>{percent(step.value, total)}%</small></div></li>)}</ol></div>;
}
export function Heatmap({ values }: { values: number[][] }) {
  const maximum = Math.max(1, ...values.flat());
  return <><div className="gx-heatmap-key"><span>Kam</span>{[0, 1, 2, 3, 4].map(level => <i key={level} data-level={level} />)}<span>Ko‘p</span></div>
    <div className="gx-heatmap-scroll"><div className="gx-heatmap">
      {values.map((row, day) => <div className="gx-heatmap-row" key={day}><span>{weekdays[day]}</span>{row.map((value, hour) => <i key={hour} data-level={value === 0 ? 0 : Math.max(1, Math.ceil(value / maximum * 4))} title={`${weekdays[day]}, ${String(hour).padStart(2, "0")}:00 (UTC) — ${value} ta faollik`} />)}</div>)}
      <div className="gx-heatmap-hours"><span />{Array.from({ length: 24 }, (_, hour) => <span key={hour}>{hour % 4 === 0 || hour === 23 ? String(hour).padStart(2, "0") : ""}</span>)}</div>
    </div></div><p className="gx-hint">Hafta kunlari × soatlar (UTC). Katak ustida aniq son ko‘rinadi.</p>
  </>;
}
