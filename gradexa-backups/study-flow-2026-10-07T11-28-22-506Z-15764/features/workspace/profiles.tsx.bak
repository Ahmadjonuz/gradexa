"use client";
import Link from "next/link";
import { useState, useRef } from "react";
import { BookOpen, CheckCircle2, Award, User, ShieldCheck, Save, ArrowRight, Camera, XCircle } from "lucide-react";
import type { GradexaProfile } from "@/lib/auth";
import { AccountHeading, AccountPanel, SecurityPanel } from "./account-ui";
import { formatDate, initials } from "./account-utils";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Progress } from "@/components/ui/progress";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@/components/ui/tabs";
import { Choice } from "./ui";
import { useWorkspace, saveWorkspace } from "./store";
import { studentProgress, studentSchema, type Student } from "./model";
import { StudentAccess } from "./student-pages";
import {
  PageHeading,
  WorkspaceGate,
  CourseEmpty,
  MetricRow,
  saved,
} from "./ui";
export function StudentProfile({ account }: { account?: GradexaProfile | null }) {
  const w = useWorkspace();
  const [tab, setTab] = useState("profile");
  const attempts = w.data.attempts.filter(a => a.studentId === w.student?.id).sort((a, b) => b.createdAt.localeCompare(a.createdAt));
  const courses = w.courses.filter(c => w.student?.courseIds.includes(c.id));
  const progress = courses.map(c => ({ ...c, ...studentProgress(w.data, w.student?.id ?? "", c.id) }));
  const completed = progress.reduce((sum, c) => sum + c.completed, 0);
  const average = attempts.length ? Math.round(attempts.reduce((sum, a) => sum + a.score, 0) / attempts.length) : null;
  const displayName = w.student?.name ?? account?.full_name ?? "Student";
  return (
    <StudentAccess w={w}>
      <div className="ga-page">
        <AccountHeading title="Profil" subtitle="Ma’lumotlaringiz, o‘quv natijalaringiz va xavfsizlik." />
        <AccountPanel className="ga-profile-hero"><span className="ga-avatar ga-avatar-image">{w.student?.avatar ? <img src={w.student.avatar} alt="Profil rasmi" /> : initials(displayName)}</span><div><h2>{displayName}</h2><p>{account?.email ?? w.student?.email}</p><span className="ga-pill is-good"><CheckCircle2 size={13} />&nbsp; Faol talaba</span></div><img src="/images/gradexa/learning-hero.png" width="245" height="160" alt="" /><div className="ga-profile-quote">Har bir qadam —<br />yangi imkoniyat.<i /></div></AccountPanel>
        <Tabs value={tab} onValueChange={setTab}><TabsList className="ga-tabs" variant="line" aria-label="Profil bo‘limlari"><TabsTrigger value="profile"><User />Shaxsiy ma’lumotlar</TabsTrigger><TabsTrigger value="security"><ShieldCheck />Xavfsizlik</TabsTrigger></TabsList>
        <TabsContent value="security"><div className="ga-narrow"><SecurityPanel /></div></TabsContent><TabsContent value="profile"><div className="ga-profile-grid">
          {w.student && <ProfileForm key={w.student.id} student={w.student} />}
          <AccountPanel title="O‘quv statistikasi"><div className="ga-mini-stats"><div><BookOpen /><strong>{courses.length}</strong><span>Kurslar</span></div><div><CheckCircle2 /><strong>{completed}</strong><span>Tugallangan darslar</span></div><div><Award /><strong>{average === null ? "—" : average + "%"}</strong><span>O‘rtacha ball</span></div></div><h3>Kurslar bo‘yicha o‘sish</h3>{progress.map(c => <div className="ga-learning-course" key={c.id}><div><Link href={"/student/courses/" + c.id}>{c.title}</Link><strong>{c.percent}%</strong></div><Progress value={c.percent} aria-label={c.title + ": " + c.percent + "%"} /></div>)}{!progress.length && <p className="ga-text">Hozircha biriktirilgan kurs yo‘q.</p>}<h3 className="mt-7">So‘nggi natijalar</h3>{attempts.length ? <ul className="ga-activity">{attempts.slice(0, 3).map(a => <li key={a.id}><Link href={"/student/results/" + a.id}>{a.score >= a.passScore ? <CheckCircle2 size={17} className="ga-green" /> : <XCircle size={17} className="ga-red" />}<span>{a.title}<small>{formatDate(a.createdAt)}</small></span><strong>{a.score}%</strong></Link></li>)}</ul> : <p className="ga-text mt-3">Birinchi test natijangiz shu yerda ko‘rinadi.</p>}<Button variant="outline" asChild className="mt-5 w-full"><Link href="/student/results">Barcha natijalar<ArrowRight size={16} /></Link></Button><p className="ga-field-note">O‘quv profili: {w.student?.name}. Statistika akkauntingizda saqlangan dars va testlarga asoslanadi.</p></AccountPanel>
          <SecurityPanel />
        </div></TabsContent></Tabs>
      </div>
    </StudentAccess>
  );
}
function ProfileForm({ student }: { student: Student }) {
  const version = useRef(student.updatedAt);
  const [name, setName] = useState(student.name), [bio, setBio] = useState(student.bio);
  const [language, setLanguage] = useState(student.language ?? "uz"), [avatar, setAvatar] = useState(student.avatar ?? "");
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState(""), [error, setError] = useState(""), [uploading, setUploading] = useState(false);
  async function upload(file?: File) {
    if (!file) return;
    setError(""); setMessage("");
    if (!["image/png", "image/jpeg", "image/webp"].includes(file.type) || file.size > 5 * 1024 * 1024) { setError("PNG, JPG yoki WEBP rasm tanlang. Hajmi 5 MB gacha."); return; }
    setUploading(true);
    const url = URL.createObjectURL(file);
    try {
      const image = new Image(); image.src = url; await image.decode();
      const canvas = document.createElement("canvas"); canvas.width = canvas.height = 256;
      const ctx = canvas.getContext("2d"), size = Math.min(image.width, image.height);
      if (!ctx) throw new Error();
      ctx.drawImage(image, (image.width - size) / 2, (image.height - size) / 2, size, size, 0, 0, 256, 256);
      setAvatar(canvas.toDataURL("image/webp", .85));
    } catch { setError("Rasmni o‘qib bo‘lmadi. Boshqa rasm tanlang."); }
    finally { URL.revokeObjectURL(url); setUploading(false); }
  }
  return <form className="ga-panel ga-profile-form" onSubmit={async e => {
    e.preventDefault(); setError("");
    if (saving) return;
    setSaving(true);
    const result = await saveWorkspace("profile", { name, bio, language, avatar, updatedAt: version.current });
    setSaving(false);
    if (!result.ok) { setError(result.message); return; }
    version.current = result.updatedAt;
    saved(result); setMessage("O‘quv profili Supabase’da saqlandi.");
  }}>
    <div className="ga-person"><span className="ga-avatar ga-avatar-image">{avatar ? <img src={avatar} alt="Profil rasmi" /> : initials(name)}</span><div><h2>O‘quv profili</h2><p>Shaxsiy ma’lumotlar</p></div></div>
    <div className="ga-fields"><label className="ga-avatar-upload"><span className="flex items-center gap-2"><Camera size={16} />Profil rasmini yangilash</span><Input type="file" accept="image/png,image/jpeg,image/webp" disabled={uploading || saving} onChange={e => { void upload(e.target.files?.[0]); e.target.value = ""; }} /><small>PNG, JPG, WEBP · 5 MB gacha</small></label>
      {avatar && <Button type="button" size="sm" variant="outline" onClick={() => { setAvatar(""); setMessage(""); }}>Rasmni olib tashlash</Button>}
      <label>To‘liq ism *<Input required minLength={2} maxLength={100} value={name} onChange={e => { setName(e.target.value); setMessage(""); }} /></label>
      <label>Email<Input value={student.email} readOnly /></label>
      <Choice label="Afzal o‘quv tili" value={language} onChange={v => { setLanguage(v as typeof language); setMessage(""); }} items={[{ value: "uz", label: "UZ · O‘zbekcha" }, { value: "en", label: "EN · English" }, { value: "ru", label: "RU · Русский" }]} />
      <label>Men haqimda<Textarea maxLength={1000} rows={3} value={bio} onChange={e => { setBio(e.target.value); setMessage(""); }} /></label>
      <Button type="submit" disabled={uploading || saving}><Save size={16} />{uploading ? "Rasm yuklanmoqda…" : saving ? "Saqlanmoqda…" : "Saqlash"}</Button>
    </div>{message && <p className="ga-success mt-4" role="status"><CheckCircle2 size={16} />{message}</p>}{error && <p className="field-error mt-4" role="alert">{error}</p>}
    <p className="ga-field-note">Rasm, ism va til Supabase profilingizda saqlanadi. Tanlangan til profil ma’lumoti bo‘lib, kabinet interfeysini o‘zgartirmaydi.</p>
  </form>;
}
export function StudentRecord({ studentId }: { studentId: string }) {
  const w = useWorkspace();
  const student = w.data.students.find((s) => s.id === studentId);
  const attempts = w.data.attempts.filter((a) => a.studentId === studentId);
  return (
    <WorkspaceGate workspace={w}>
      {!student ? (
        <CourseEmpty
          title="Talaba topilmadi"
          description="Talabalar ro‘yxatiga qayting."
        >
          <Button asChild>
            <Link href="/admin/students">Talabalar</Link>
          </Button>
        </CourseEmpty>
      ) : (
        <>
          <Link href="/admin/students" className="back-link">
            ← Talabalar
          </Link>
          <PageHeading title={student.name} subtitle={student.email} />
          <MetricRow
            items={[
              { label: "Kurslar", value: student.courseIds.length },
              {
                label: "Yakunlangan darslar",
                value: w.data.completed[studentId]?.length ?? 0,
              },
              { label: "Test urinishlari", value: attempts.length },
            ]}
          />
          <section className="panel">
            <h2 className="section-title">Profil haqida</h2>
            <p className="muted-paragraph">
              {student.bio || "Tavsif kiritilmagan."}
            </p>
          </section>
          <h2 className="section-title mt-7 mb-4">Kurslar bo‘yicha progress</h2>
          {w.courses
            .filter((c) => student.courseIds.includes(c.id))
            .map((c) => {
              const p = studentProgress(w.data, studentId, c.id);
              return (
                <div className="panel mb-4" key={c.id}>
                  <div className="panel-heading">
                    <Link className="text-link" href={`/admin/courses/${c.id}`}>
                      {c.title}
                    </Link>
                    <span>
                      {p.completed}/{p.total} dars · {p.percent}%
                    </span>
                  </div>
                  <Progress
                    className="mt-4"
                    value={p.percent}
                    aria-label={`${c.title} progress`}
                  />
                </div>
              );
            })}
          <h2 className="section-title mt-7 mb-4">Testlar tarixi</h2>
          {attempts.length ? (
            attempts.map((a) => (
              <Link
                key={a.id}
                className="panel activity-row"
                href={`/admin/quiz-results/${a.id}`}
              >
                <span>{a.title}</span>
                <strong>{a.score}%</strong>
              </Link>
            ))
          ) : (
            <p className="muted-paragraph">Hali test topshirilmagan.</p>
          )}
        </>
      )}
    </WorkspaceGate>
  );
}
