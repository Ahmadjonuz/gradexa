// Read-only component rendering with an isolated workspace fixture; no Auth/network calls.
import assert from "node:assert/strict";
import test, { after } from "node:test";
import path from "node:path";
import { fileURLToPath } from "node:url";
import React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { createServer } from "vite";

const root = fileURLToPath(new URL("..", import.meta.url));
const fixtureKey = "__gradexaStudyRenderFixture";
const mocks = {
  [path.join(root, "features/workspace/store")]: `export function useWorkspace(){return globalThis.${fixtureKey};} export async function refreshWorkspace(){} export async function saveWorkspace(){throw Error('Render must never write');} export async function submitAttempt(){throw Error('Render must never submit');}`,
  [path.join(root, "features/courses/use-courses")]: `export async function refreshCourses(){} export function useCourses(){return {courses:[],ready:true,error:null};}`,
  [path.join(root, "features/enrollments/use-enrollments")]: `export async function refreshEnrollments(){} export async function enrollInCourse(){throw Error('Render must never enroll');}`,
  [path.join(root, "features/lessons/use-lessons")]: `export async function refreshLessons(){}`,
  [path.join(root, "components/auth/logout-button")]: `export function LogoutButton(){return null;}`,
  "next/link": `import React from 'react'; export default function Link({href,prefetch,scroll,replace,...props}){return React.createElement('a',{...props,href});}`,
  "next/navigation": `export function useRouter(){return {push(){throw Error('Render must never navigate');}};}`,
};
const vite = await createServer({ appType: "custom", configFile: false, root, resolve: { alias: { "@": root } }, esbuild: { jsx: "automatic" }, server: { middlewareMode: true, ws: false }, plugins: [{
  name: "study-render-fixtures", enforce: "pre",
  resolveId(source, importer) {
    const resolved = source.startsWith(".") && importer ? path.resolve(path.dirname(importer), source) : source;
    const candidate = Object.hasOwn(mocks, resolved) ? resolved : path.normalize(resolved).replace(/\.[jt]sx?$/, "");
    if (Object.hasOwn(mocks, candidate)) return "\0study-fixture:" + candidate;
  },
  load(id) { if (id.startsWith("\0study-fixture:")) return mocks[id.slice("\0study-fixture:".length)]; },
}] });
after(async () => { delete globalThis[fixtureKey]; await vite.close(); });
const { seedWorkspace } = await vite.ssrLoadModule("/features/workspace/model.ts");
const { seedCourses } = await vite.ssrLoadModule("/features/courses/model.ts");
const { StudentHome } = await vite.ssrLoadModule("/features/workspace/student-pages.tsx");
const { QuizRunner, StudentQuizzes } = await vite.ssrLoadModule("/features/workspace/student-quizzes.tsx");
const { Results, ResultDetail } = await vite.ssrLoadModule("/features/workspace/results.tsx");
const { CourseTable, Heatmap } = await vite.ssrLoadModule("/features/dashboard/report-ui.tsx");
function fixture(count = 0) {
  const data = structuredClone(seedWorkspace);
  const student = { ...data.students[0], status: "active", courseIds: [seedCourses[0].id] };
  data.students = [student]; data.tasks = []; data.quizzes = [data.quizzes[0]];
  data.attempts = Array.from({ length: count }, (_, i) => ({ id: "attempt-" + i, quizId: data.quizzes[0].id, studentId: student.id, studentName: student.name, courseId: seedCourses[0].id, title: "Saved quiz " + i, score: 100, passScore: 70, createdAt: `2026-10-07T${String(i % 24).padStart(2, "0")}:00:00Z`, answers: data.quizzes[0].questions.map(q => q.correct), questions: data.quizzes[0].questions }));
  globalThis[fixtureKey] = { data, courses: structuredClone(seedCourses), student, ready: true, error: null };
  return globalThis[fixtureKey];
}
const render = (component, props = {}) => renderToStaticMarkup(React.createElement(component, props));

test("student home renders genuinely latest results even when server data is ID-ordered", () => {
  fixture(5);
  const html = render(StudentHome);
  assert.ok(html.includes("Saved quiz 4")); assert.ok(html.includes("Saved quiz 3"));
  assert.ok(!html.includes("Saved quiz 0"));
});

test("empty published quiz renders a safe unavailable state instead of crashing", () => {
  const w = fixture(); w.data.quizzes[0].questions = [];
  const html = render(QuizRunner, { quizId: w.data.quizzes[0].id });
  assert.ok(html.includes("Test mavjud emas")); assert.ok(!html.includes("quiz-runner"));
});

test("exhausted quiz list and direct route retain working latest-result links", () => {
  const w = fixture(3); w.data.quizzes[0].maxAttempts = 3;
  const list = render(StudentQuizzes), runner = render(QuizRunner, { quizId: w.data.quizzes[0].id });
  assert.ok(list.includes("Urinishlar tugagan")); assert.ok(list.includes('href="/student/results/attempt-2"'));
  assert.ok(runner.includes('href="/student/results/attempt-2"'));
});

test("results render ten rows, full-filter metrics and Supabase storage copy", () => {
  fixture(23);
  const html = render(Results, { student: true });
  assert.equal((html.match(/aria-controls="attempt-/g) ?? []).length, 10);
  assert.ok(html.includes("1–10 / 23 ta urinish")); assert.ok(html.includes("Natijalar Supabase’da saqlanadi"));
  assert.ok(html.includes("Toshkent")); assert.ok(html.includes("23 ta urinish"));
});

test("results initial quiz filter works for student routes", () => {
  fixture(3);
  const html = render(Results, { student: true, initialQuiz: "missing-quiz" });
  assert.ok(html.includes("Filtrga mos natija topilmadi"));
  assert.equal((html.match(/aria-controls="attempt-/g) ?? []).length, 0);
});

test("old results stay readable but do not offer retakes after enrollment is removed", () => {
  const w = fixture(1); w.student.courseIds = [];
  const html = render(ResultDetail, { student: true, attemptId: "attempt-0" });
  assert.ok(html.includes("Javoblar tahlili")); assert.ok(!html.includes("Qayta topshirish"));
  assert.ok(html.includes('href="/student/courses"'));
});

test("sample course rows have no misleading links to non-existent real courses", () => {
  const courses = [{ id: "fixture", name: "Design preview", students: 1, progress: 50 }];
  assert.ok(!render(CourseTable, { courses, linkCourses: false }).includes('href="/admin/courses/fixture"'));
  assert.ok(render(CourseTable, { courses }).includes('href="/admin/courses/fixture"'));
});

test("heatmap declares the same timezone as its grouping", () => {
  const html = render(Heatmap, { values: Array.from({ length: 7 }, () => Array(24).fill(0)) });
  assert.ok(html.includes("Toshkent, UTC+05:00")); assert.ok(html.includes("00:00 (Toshkent)"));
});
