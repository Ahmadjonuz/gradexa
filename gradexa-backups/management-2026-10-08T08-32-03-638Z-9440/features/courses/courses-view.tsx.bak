"use client";
import Link from "next/link";
import { useState } from "react";
import { Grid2X2, List, Plus, Search } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "@/components/ui/table";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import { filterCourses, statusLabels } from "./model";
import { useWorkspace } from "@/features/workspace/store";
import { WorkspaceGate, Choice } from "@/features/workspace/ui";
import { AccountHeading } from "@/features/workspace/account-ui";
import { courseFacts } from "@/features/workspace/learning-model";
import { CourseEmpty, StatusBadge } from "./course-shared";
import { CourseCard } from "./course-card";
import { courseCover } from "./course-art";
import { CourseMigration } from "./course-migration";

export function CoursesView() {
  const w = useWorkspace();
  const [query, setQuery] = useState(""), [status, setStatus] = useState("all"), [sort, setSort] = useState("recent"), [view, setView] = useState("grid");
  const results = filterCourses(w.courses, query, status, sort);
  return <WorkspaceGate workspace={w}><div className="ga-page gc-page"><AccountHeading title="Kurslar" subtitle="Barcha kurslar va ularning ko‘rsatkichlari."><Button asChild><Link href="/admin/courses/new"><Plus size={19} />Yangi kurs</Link></Button></AccountHeading>
    <CourseMigration courses={w.courses} />
    <div className="gc-toolbar"><div className="gc-search"><Search size={18} /><Input value={query} onChange={e => setQuery(e.target.value)} placeholder="Kurslarni qidirish…" aria-label="Kurslarni qidirish" /></div><Choice label="Holat" value={status} onChange={setStatus} items={[{ value: "all", label: "Barcha holatlar" }, ...Object.entries(statusLabels).map(([value, label]) => ({ value, label }))]} /><Choice label="Saralash" value={sort} onChange={setSort} items={[{ value: "recent", label: "Oxirgi yangilangan" }, { value: "title", label: "Nomi bo‘yicha" }, { value: "students", label: "Talabalar soni" }]} /><ToggleGroup type="single" value={view} onValueChange={v => { if (v) setView(v); }} className="gc-view-toggle" aria-label="Kurslar ko‘rinishi"><ToggleGroupItem value="grid" aria-label="Kartalar"><Grid2X2 size={18} /></ToggleGroupItem><ToggleGroupItem value="list" aria-label="Jadval"><List size={18} /></ToggleGroupItem></ToggleGroup></div>
    <p className="gc-count" aria-live="polite">{results.length} ta kurs · {w.courses.filter(c => c.status === "published").length} ta nashr etilgan</p>
    {results.length ? view === "grid" ? <div className="gc-course-grid">{results.map(course => <CourseCard key={course.id} course={course} lessons={courseFacts(w.data, course).lessons} />)}</div> : <div className="ga-panel"><Table className="gc-course-table"><TableHeader><TableRow><TableHead>Kurs</TableHead><TableHead>Holat</TableHead><TableHead>Darslar</TableHead><TableHead>Talabalar</TableHead><TableHead>Yakunlanish</TableHead><TableHead><span className="sr-only">Tahrirlash</span></TableHead></TableRow></TableHeader><TableBody>{results.map(c => <TableRow key={c.id}><TableCell><Link href={"/admin/courses/" + c.id} className="gc-table-title"><img src={courseCover(c)} width="72" height="44" alt="" /><strong>{c.title}</strong></Link></TableCell><TableCell><StatusBadge status={c.status} /></TableCell><TableCell>{courseFacts(w.data, c).lessons}</TableCell><TableCell>{c.students}</TableCell><TableCell>{c.progress}%</TableCell><TableCell><Button variant="outline" asChild><Link href={"/admin/courses/" + c.id + "?edit=1"}>Tahrirlash</Link></Button></TableCell></TableRow>)}</TableBody></Table></div> : <CourseEmpty title="Kurs topilmadi" description="Qidiruv yoki holat filtrini o‘zgartiring."><Button variant="outline" onClick={() => { setQuery(""); setStatus("all"); }}>Filtrlarni tozalash</Button></CourseEmpty>}
    <p className="ga-footnote">Kurslar Supabase’da saqlanadi. Talabalar soni va progress bazadagi o‘quv yozuvlaridan hisoblanadi.</p>
  </div></WorkspaceGate>;
}
